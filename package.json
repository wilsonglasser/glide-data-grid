{
    "name": "@glideapps/glide-data-grid",
    "version": "6.0.4-keep-focus-on-accept",
    "description": "Fork of glide-data-grid with the keepFocusOnEnterAccept prop. Built artifacts live under packages/core/dist so this branch is installable directly via `npm i github:wilsonglasser/glide-data-grid#keep-focus-on-accept-pkg`.",
    "sideEffects": [
        "**/*.css"
    ],
    "type": "module",
    "browser": "./packages/core/dist/esm/index.js",
    "main": "./packages/core/dist/cjs/index.js",
    "module": "./packages/core/dist/esm/index.js",
    "types": "./packages/core/dist/dts/index.d.ts",
    "exports": {
        ".": {
            "types": "./packages/core/dist/dts/index.d.ts",
            "import": "./packages/core/dist/esm/index.js",
            "require": "./packages/core/dist/cjs/index.js"
        },
        "./dist/index.css": {
            "import": "./packages/core/dist/index.css",
            "require": "./packages/core/dist/index.css"
        },
        "./index.css": {
            "import": "./packages/core/dist/index.css",
            "require": "./packages/core/dist/index.css"
        }
    },
    "files": [
        "packages/core/dist"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/wilsonglasser/glide-data-grid.git"
    },
    "license": "MIT",
    "dependencies": {
        "@linaria/react": "^6.3.0",
        "canvas-hypertxt": "^1.0.3",
        "react-number-format": "^5.4.4"
    },
    "peerDependencies": {
        "lodash": "^4.17.19",
        "marked": "^16.0.10",
        "react": "^16.12.0 || 17.x || 18.x || 19.x",
        "react-dom": "^16.12.0 || 17.x || 18.x || 19.x",
        "react-responsive-carousel": "^3.2.7"
    }
}
